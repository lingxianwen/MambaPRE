    "workers": 4,
    "amp": true,
    "threshold": 0.5,
    "threshold_grid": [0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9],
    "patience": 8
  },
  "loss": {
    "boundary_positive_weight": 8.0,
    "role_weight": 0.2,
    "type_weight": 0.1,
    "gate_weight": 0.05
