{
  "seed": 1337,
  "device": "auto",
  "output_dir": "runs/dual_bimamba_guided_seed1337",
  "data": {
    "train": "data/processed/core_corpus/train.jsonl",
    "validation": "data/processed/core_corpus/validation.jsonl"
  },
  "model": {
    "architecture": "dual_bimamba",
    "backend": "mamba1",
    "d_model": 128,
    "num_layers": 4,
    "dropout": 0.1,
